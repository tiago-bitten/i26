<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>i26.Core</RootNamespace>
        <AssemblyName>i26.Core</AssemblyName>
        <PackageId>i26.Core</PackageId>
        <Description>
            i26 primitives. Includes strongly typed identifiers in the TypeID format
            ({prefix}_{uuidv7 in Crockford base32}), created by the application and sortable by
            creation instant.
        </Description>
        <PackageTags>typeid;uuid7;uuidv7;strongly-typed-id;identifier;ddd</PackageTags>
    </PropertyGroup>

    <!-- No external dependencies by design. -->

    <!--
        The generator runs inside the compiler, so it is referenced as an analyzer and none of it
        travels with the assembly. Shipping it inside this package means [TypedId] works the moment
        i26.Core is referenced, with nothing else to install.
    -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\i26.Core.Generators\i26.Core.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\i26.Core.Generators\bin\$(Configuration)\netstandard2.0\i26.Core.Generators.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
