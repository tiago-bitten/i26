<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>i26.Cqrs</RootNamespace>
        <AssemblyName>i26.Cqrs</AssemblyName>
        <PackageId>i26.Cqrs</PackageId>
        <Description>
            Command and query contracts for i26: handlers that answer with a Result, and the
            registration that wires every one of them into the container.
        </Description>
        <PackageTags>cqrs;command;query;handler;result;mediator</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\i26.Core\i26.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    </ItemGroup>

</Project>
