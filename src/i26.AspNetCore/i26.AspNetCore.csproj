<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>i26.AspNetCore</RootNamespace>
        <AssemblyName>i26.AspNetCore</AssemblyName>
        <PackageId>i26.AspNetCore</PackageId>
        <Description>
            ASP.NET Core integration for i26: maps a failed Result to an RFC 9457 ProblemDetails
            response, with optional error description translation.
        </Description>
        <PackageTags>result;problemdetails;rfc9457;minimal-api;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\i26.Core\i26.Core.csproj" />
    </ItemGroup>

</Project>
