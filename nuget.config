<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This library depends on no private feed. The <clear /> drops the sources inherited from the
    user/machine NuGet.Config, so restore does not break on authenticated feeds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
